---
// Making section on Exploring!: same layout as the other entries (text column + photos with a lightbox),
// built from the explore-section projects so there is no second click. Photos are the cover, the images
// written into the Markdown body, with the front-matter gallery (e.g. the process animation) first.
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;

const assets = import.meta.glob('/src/assets/projects/**/*.{jpg,jpeg,png,gif,webp}', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const fullFor = async (img: ImageMetadata) =>
  img.format === 'gif' ? img.src : (await getImage({ src: img, width: 1600, format: 'webp', quality: 82 })).src;

const rendered = await Promise.all(
  projects.map(async (p) => {
    const d = p.data;
    const body = p.body ?? '';
    const imgRe = /!\[([^\]]*)\]\(([^)]+)\)/g;
    const inline: { src: ImageMetadata; alt: string }[] = [];
    for (const m of body.matchAll(imgRe)) {
      const key = '/src/' + m[2].replace(/^(\.\.\/)+/, '');
      if (assets[key]) inline.push({ src: assets[key], alt: m[1] });
    }
    const paras = body
      .replace(imgRe, '')
      .split(/\n\s*\n/)
      .map((t) => t.trim())
      .filter(Boolean);
    const photos = [
      ...d.gallery.map((g) => ({ src: g.src as ImageMetadata, alt: g.alt })),
      ...(d.cover ? [{ src: d.cover as ImageMetadata, alt: d.coverAlt }] : []),
      ...inline,
    ];
    const fulls = await Promise.all(photos.map((x) => fullFor(x.src)));
    return { p, paras, photos, fulls };
  }),
);
---

<ul class="lead-list uniform">
  {
    rendered.map(({ p, paras, photos, fulls }) => (
      <li class="lead">
        <div class="lead-text">
          <h2>{p.data.title}</h2>
          <p class="lead-meta">{[p.data.year, p.data.place].filter(Boolean).join(', ')}</p>
          <div class="lead-body">{paras.map((t) => <p>{t}</p>)}</div>
        </div>
        {photos.length > 0 && (
          <div class="panel gallery-panel">
            <ul class:list={['masonry', { 'two-rows': p.data.twoRows }]} style={p.data.twoRows ? `--fit:${p.data.twoRows}` : p.data.tileHeight ? `--h:${p.data.tileHeight}rem` : undefined}>
              {photos.map((x, n) => (
                <li style={`--r:${(x.src.width / x.src.height).toFixed(3)}`}>
                  <button
                    type="button"
                    class="shot-btn"
                    data-gallery={p.id}
                    data-full={fulls[n]}
                    data-alt={x.alt}
                    aria-label={`View larger: ${x.alt}`}
                  >
                    {x.src.format === 'gif' ? (
                      <img src={x.src.src} alt="" width={x.src.width} height={x.src.height} loading="lazy" decoding="async" />
                    ) : (
                      <Image src={x.src} alt="" widths={[320, 480, 640]} sizes="(max-width: 560px) 100vw, (max-width: 1100px) 50vw, 304px" format="webp" quality={78} />
                    )}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}
      </li>
    ))
  }
</ul>
