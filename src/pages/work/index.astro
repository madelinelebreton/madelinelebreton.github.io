---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectTile from '../../components/ProjectTile.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft && p.data.section === 'work')).sort(
  (a, b) => a.data.order - b.data.order,
);
// Cards are grouped under headings; within a group they keep the site's original order (`order` in each project's front matter).
const groups = [
  { id: 'research', label: 'Research and instrumentation' },
  { id: 'robotics', label: 'Robotics and controls' },
  { id: 'spatial', label: 'Spatial data and systems mapping' },
  { id: 'design', label: 'Design projects' },
]
  .map((g) => ({ ...g, items: projects.filter((p) => p.data.group === g.id) }))
  .filter((g) => g.items.length > 0);
const ungrouped = projects.filter((p) => !p.data.group);
---

<Base title="Work" description="Engineering projects and research by Madeline LeBreton.">
  <header class="page-head">
    <h1>Work</h1>
  </header>
  {
    groups.map((g) => (
      <section aria-labelledby={`${g.id}-h`} class="work-group">
        <h2 id={`${g.id}-h`}>{g.label}</h2>
        <div class="panel">
          <ul class="grid">
            {g.items.map((p) => <ProjectTile project={p} />)}
          </ul>
        </div>
      </section>
    ))
  }
  {
    ungrouped.length > 0 && (
      <section aria-labelledby="more-h" class="work-group">
        <h2 id="more-h">More</h2>
        <div class="panel">
          <ul class="grid">
            {ungrouped.map((p) => <ProjectTile project={p} />)}
          </ul>
        </div>
      </section>
    )
  }
</Base>
