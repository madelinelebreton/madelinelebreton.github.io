---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const items = (await getCollection('news', (n) => !n.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Media" description="Articles, interviews and videos featuring Madeline LeBreton.">
  <header class="page-head">
    <h1>Media</h1>
  </header>

  <ul class="news-list">
    {
      items.map((n) => (
        <li>
          <a class="news-img" href={n.data.href} rel="noopener" tabindex="-1" aria-hidden="true">
            <Image src={n.data.image} alt="" widths={[280, 420, 560]} sizes="(max-width: 820px) 14rem, 17rem" format="webp" quality={80} style={`object-position:${n.data.focal}`} />
          </a>
          <div class="news-text">
            <p class="news-meta">
              <span>{n.data.outlet}</span>
              <time datetime={n.data.date.toISOString().slice(0, 10)}>{n.data.dateLabel ?? fmt.format(n.data.date)}</time>
            </p>
            <h2>{n.data.titlePrefix && <>{n.data.titlePrefix} </>}<a href={n.data.href} rel="noopener">{n.data.title}</a>{n.data.titleSuffix && <> {n.data.titleSuffix}</>}</h2>
            {n.data.blurb && <p class="news-blurb">{n.data.blurb}</p>}
            <a class="read-more" href={n.data.href} rel="noopener">
              {n.data.kind === 'video' ? 'Watch' : 'Read more'}<span class="sr-only"> at {n.data.outlet}: {n.data.title}</span>
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</Base>
